{
  "name": "@alonetone/stitches",
  "version": "3.0.0",
  "description": "Stitching Together MP3 Playback in HTML5 Audio with ES6",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:webkit": "playwright test --project=webkit",
    "browserstack": "browserstack-node-sdk playwright test --config=playwright.browserstack.config.js",
    "lint": "eslint src tests *.config.js",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudara/stitches.git"
  },
  "files": [
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mp3",
    "html5",
    "audio",
    "playback",
    "es6"
  ],
  "author": "Sudara",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sudara/stitches/issues"
  },
  "homepage": "https://github.com/sudara/stitches#readme",
  "private": false,
  "prettier": {
    "semi": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "browserstack-node-sdk": "^1.55.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "prettier": "^3.8.3"
  }
}
